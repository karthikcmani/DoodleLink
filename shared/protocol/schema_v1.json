{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoodleLink Protocol v1",
  "description": "JSON schema for DoodleLink communication protocol events between Android client and Windows desktop host.",
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Protocol version integer"
    },
    "type": {
      "type": "string",
      "enum": [
        "hello",
        "pair",
        "pair_success",
        "stroke_start",
        "stroke_points",
        "stroke_end",
        "stroke_cancel",
        "undo",
        "redo",
        "clear_canvas",
        "ping",
        "pong",
        "error"
      ]
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "code": {
      "type": "string",
      "description": "Short-lived pairing authentication code or error code"
    },
    "client_name": {
      "type": "string",
      "description": "Friendly name of client device"
    },
    "message": {
      "type": "string",
      "description": "Human-readable status or error message"
    },
    "stroke_id": {
      "type": "string",
      "description": "Unique stroke UUID or sequence identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Strictly monotonic event sequence number"
    },
    "tool": {
      "type": "string",
      "enum": ["pen", "eraser"],
      "default": "pen"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Hexadecimal RGB color code (e.g. #000000)"
    },
    "width": {
      "type": "number",
      "minimum": 0.0001,
      "maximum": 0.5,
      "description": "Normalized stroke width relative to logical canvas width"
    },
    "timestamp": {
      "type": "number",
      "description": "Heartbeat or event timestamp in milliseconds"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "y": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "timestamp": {
            "type": "number",
            "description": "Epoch timestamp in milliseconds"
          },
          "pressure": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 1.0
          }
        }
      }
    }
  }
}
